SHIYU_MODE=demo
APP_ORIGIN=http://127.0.0.1:3000
# Set a random value of at least 32 characters before enabling live mode.
AUTH_SECRET=
SHIYU_DATA_DIR=.data
# Optional production backends. Without DATABASE_URL, local SQLite is used.
DATABASE_URL=
REDIS_URL=
# Server-side only. Never expose this value through NEXT_PUBLIC_* variables.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.6-luna
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_SPEECH_MODEL=gpt-4o-mini-tts
OPENAI_VOICE=coral
# Added automatically when a Vercel Blob store is connected.
BLOB_READ_WRITE_TOKEN=
# Set only behind a reverse proxy that strips untrusted forwarding headers.
TRUST_PROXY=false
