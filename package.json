{
  "name": "shiyu-film",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "test": "npm run test:server && npm run test:e2e",
    "typecheck": "tsc --noEmit",
    "worker": "npm run build:server && node --env-file-if-exists=.env.local .server/worker/index.js",
    "test:server": "npm run build:server && node --test .server/tests/server/services.test.js",
    "test:e2e": "playwright test",
    "build:server": "tsc -p tsconfig.server.json",
    "build:pages": "node scripts/build-pages.mjs",
    "test:pages": "playwright test --config playwright.pages.config.ts"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "bullmq": "^6.3.4",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "pg": "^8.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=24"
  }
}
